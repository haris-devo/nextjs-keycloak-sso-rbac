# infra/.env.example
# Production template. For local development, use pnpm env:local.
POSTGRES_PASSWORD=replace-with-random-database-password
KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-bootstrap-password
AUTH_KEYCLOAK_SECRET=replace-with-random-client-secret
AUTH_SECRET=replace-with-at-least-32-random-characters
WEB_DOMAIN=web.example.com
AUTH_DOMAIN=auth.example.com
WEB_ORIGIN=https://web.example.com
ACME_EMAIL=ops@example.com
