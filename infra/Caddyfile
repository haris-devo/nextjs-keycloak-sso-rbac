# infra/Caddyfile
{
  email {$ACME_EMAIL}
  admin off
}

(keycloak_upstream) {
  reverse_proxy keycloak:8080 {
    header_up Host {$AUTH_DOMAIN}
    header_up -Forwarded
    header_up X-Forwarded-Host {$AUTH_DOMAIN}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Port 443
    header_up -X-Forwarded-Prefix
    header_up -X-Original-URL
    header_up -X-Original-Method
  }
}

{$WEB_DOMAIN} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy web:3000 {
    header_up Host {$WEB_DOMAIN}
    header_up -Forwarded
    header_up X-Forwarded-Host {$WEB_DOMAIN}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Port 443
  }
}

{$AUTH_DOMAIN} {
  header Strict-Transport-Security "max-age=31536000"
  # Expose only the demo realm and login assets. Everything else is private.
  @public path /realms/demo /realms/demo/* /resources/*
  handle @public {
    import keycloak_upstream
  }
  handle {
    respond "Forbidden" 403
  }
}

# Host publishing is loopback-only. Tunnel local port 443 to this listener.
https://{$AUTH_DOMAIN}:8443 {
  import keycloak_upstream
}
